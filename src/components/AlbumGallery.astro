---
import { Image, getImage } from "astro:assets";

const { title, photos } = Astro.props;

const optimizedPhotos = await Promise.all(
	photos.map(async (photo) => {

		const landscape =
			photo.image.width > photo.image.height;

		const lightboxImage = await getImage({
			src: photo.image,
			width: landscape ? 1800 : 1200,
			format: "webp",
			quality: 85,
		});

		return {
			...photo,
			lightboxSrc: lightboxImage.src,
		};
	})
);
---

<main>

	<div class="album-header">

		<a href="/photos/" class="back">
			← Photos
		</a>

		<h1>{title}</h1>

	</div>


	<section class="gallery">

		{
			optimizedPhotos.map((photo, index) => {

				const format =
					photo.image.width > photo.image.height
						? "landscape"
						: photo.image.width < photo.image.height
							? "portrait"
							: "square";
							const isLandscape = format === "landscape";

				return (

						<figure
							class={`photo ${format}`}
							style={`--delay: ${Math.min(index * 40, 400)}ms`}
						>
						<button
							class="photo-button"
							type="button"
							data-src={photo.lightboxSrc}
							data-alt={photo.alt}
						>

						<Image
							src={photo.image}
							alt={photo.alt}
							loading="lazy"

							widths={
								isLandscape
									? [480, 720, 960, 1280, 1600]
									: [240, 360, 480, 640, 800]
							}

							sizes={
								isLandscape
									? "(max-width: 600px) 100vw, (max-width: 900px) 66vw, (max-width: 1200px) 50vw, 40vw"
									: "(max-width: 600px) 50vw, (max-width: 900px) 33vw, (max-width: 1200px) 25vw, 20vw"
							}
						/>

						</button>

					</figure>

				);

			})
		}

	</section>

</main>


<!-- LIGHTBOX -->

<dialog class="lightbox" id="lightbox">

	<button
		class="lightbox-close"
		type="button"
		aria-label="Fermer"
	>
		×
	</button>

	<button
		class="lightbox-prev"
		type="button"
		aria-label="Photo précédente"
	>
		‹
	</button>

	<img
		id="lightbox-image"
		src=""
		alt=""
	/>

	<button
		class="lightbox-next"
		type="button"
		aria-label="Photo suivante"
	>
		›
	</button>

</dialog>


<style>

	* {
		box-sizing: border-box;
	}

	main {
		padding: 60px 36px 150px;
	}

	.album-header {
		margin-bottom: 60px;
	}

	.back {
		display: inline-block;
		margin-bottom: 25px;

		color: #777;
		text-decoration: none;

		font-size: 10px;
		letter-spacing: 0.12em;

		text-transform: uppercase;
	}

	.back:hover {
		color: #111;
	}

	h1 {
		margin: 0;

		font-size: clamp(40px, 6vw, 80px);
		font-weight: 400;

		letter-spacing: -0.04em;
	}


	/* GALERIE */

	.gallery {
		max-width: 1600px;
		margin: 0 auto;

		display: grid;
		grid-template-columns: repeat(5, 1fr);
		grid-auto-flow: dense;

		gap: 12px;

		container-type: inline-size;

		grid-auto-rows: calc(25cqw - 12px);
	}

	.photo {
		margin: 0;
		overflow: hidden;
		height: 100%;

		opacity: 0;
		transform: translateY(10px);

		animation: photoAppear 0.5s ease forwards;
		animation-delay: var(--delay);
	}

	@keyframes photoAppear {

		from {
			opacity: 0;
			transform: translateY(10px);
		}

		to {
			opacity: 1;
			transform: translateY(0);
		}

	}

	.photo.portrait,
	.photo.square {
		grid-column: span 1;
	}

	.photo.landscape {
		grid-column: span 2;
	}


	/* IMAGES */

	.photo-button {
		display: block;

		width: 100%;
		height: 100%;

		margin: 0;
		padding: 0;

		border: 0;
		background: none;

		cursor: pointer;
	}

	.photo-button img {
		display: block;

		width: 100%;
		height: 100%;

		object-fit: cover;

		transition:
			transform 0.25s ease,
			opacity 0.25s ease;
	}

	.photo-button:hover img {
		transform: scale(1.01);
		opacity: 0.92;
	}


	/* LIGHTBOX */

	.lightbox {
		width: 100vw;
		height: 100vh;

		max-width: none;
		max-height: none;

		margin: 0;
		padding: 0;

		border: 0;

		background: rgba(10, 10, 10, 0.98);
	}

	.lightbox[open] {
		display: flex;
		align-items: center;
		justify-content: center;
	}

	.lightbox::backdrop {
		background: #000;
	}

	#lightbox-image {
		display: block;

		max-width: 90vw;
		max-height: 90vh;

		width: auto;
		height: auto;

		object-fit: contain;

		transition: opacity 0.15s ease;
	}


	.lightbox-close {
		position: fixed;

		top: 20px;
		right: 28px;

		z-index: 10;

		padding: 10px;

		border: 0;
		background: none;

		color: white;
		font-size: 34px;

		cursor: pointer;
	}

	.lightbox-prev,
	.lightbox-next {
		position: fixed;

		top: 50%;
		transform: translateY(-50%);

		z-index: 10;

		padding: 20px;

		border: 0;
		background: none;

		color: white;
		font-size: 50px;

		cursor: pointer;
	}

	.lightbox-prev {
		left: 10px;
	}

	.lightbox-next {
		right: 10px;
	}

	.photo-button {
		-webkit-tap-highlight-color: transparent;

		appearance: none;
		-webkit-appearance: none;

		outline: none;
	}

	.photo-button:focus,
	.photo-button:active {
		background: transparent;
	}


	/* RESPONSIVE */

	@media (max-width: 1200px) {

		.gallery {
			grid-template-columns: repeat(4, 1fr);
			grid-auto-rows: calc(31.25cqw - 11.25px);
		}

	}

	@media (max-width: 900px) {

		.gallery {
			grid-template-columns: repeat(3, 1fr);
			grid-auto-rows: calc(41.6667cqw - 10px);
		}

	}

	@media (max-width: 600px) {

		main {
			padding: 40px 18px 100px;
		}

		.album-header {
			margin-bottom: 40px;
		}

		.gallery {
			grid-template-columns: repeat(2, 1fr);
			grid-auto-rows: calc(62.5cqw - 7.5px);

			gap: 12px;
		}

		#lightbox-image {
			max-width: 94vw;
			max-height: 88vh;

			transition: none;
		}

	}

	@media (prefers-reduced-motion: reduce) {

		.album,
		.photo,
		.album-header {
			animation: none;
			opacity: 1;
			transform: none;
		}

	}

</style>

<script>

	const lightbox =
		document.querySelector("#lightbox");

	const lightboxImage =
		document.querySelector("#lightbox-image");

	const photoButtons = Array.from(
		document.querySelectorAll(".photo-button")
	);

	const closeButton =
		document.querySelector(".lightbox-close");

	const previousButton =
		document.querySelector(".lightbox-prev");

	const nextButton =
		document.querySelector(".lightbox-next");


	let currentIndex = 0;

	let requestId = 0;


	/*
		Cache des grandes images déjà téléchargées.
	*/

	const imageCache = new Map();


	function preloadImage(src) {

		if (!src) {
			return Promise.resolve();
		}


		if (imageCache.has(src)) {
			return imageCache.get(src);
		}


		const promise = new Promise((resolve) => {

			const image = new Image();

			image.onload = resolve;
			image.onerror = resolve;

			image.src = src;

		});


		imageCache.set(src, promise);

		return promise;

	}


	/*
		Précharge les photos autour
		de celle actuellement affichée.
	*/

	function preloadAround(index) {

		const offsets = [
			-2,
			-1,
			1,
			2
		];


		offsets.forEach((offset) => {

			const neighbourIndex =
				(
					index
					+ offset
					+ photoButtons.length
				)
				% photoButtons.length;


			const neighbour =
				photoButtons[neighbourIndex];


			preloadImage(
				neighbour.dataset.src
			);

		});

	}


	/*
		Affiche immédiatement la petite image
		déjà présente dans la galerie.
		
		Puis la remplace par la grande version
		une fois celle-ci prête.
	*/

	async function showPhoto(index) {

		currentIndex = index;

		const myRequest =
			++requestId;


		const button =
			photoButtons[currentIndex];


		const thumbnail =
			button.querySelector("img");


		const fullSrc =
			button.dataset.src;


		const alt =
			button.dataset.alt || "";


		/*
			Image miniature immédiatement.
		*/

		if (thumbnail) {

			lightboxImage.src =
				thumbnail.currentSrc
				|| thumbnail.src;

		}


		lightboxImage.alt = alt;


		/*
			Chargement grande image.
		*/

		await preloadImage(fullSrc);


		/*
			Si entre-temps l'utilisateur
			a changé de photo, on abandonne.
		*/

		if (
			myRequest !== requestId
			|| !lightbox.open
		) {
			return;
		}


		/*
			La grande version est maintenant
			déjà en cache : remplacement immédiat.
		*/

		lightboxImage.src =
			fullSrc;


		/*
			On prépare les voisines.
		*/

		preloadAround(currentIndex);

	}


	function openLightbox(index) {

		currentIndex = index;

		const button =
			photoButtons[index];

		const thumbnail =
			button.querySelector("img");


		/*
			On remplace l'ancienne image AVANT
			d'ouvrir la fenêtre.
			
			Donc aucun flash de l'ancienne photo.
		*/

		if (thumbnail) {

			lightboxImage.src =
				thumbnail.currentSrc
				|| thumbnail.src;

		}


		lightboxImage.alt =
			button.dataset.alt || "";


		lightbox.showModal();


		showPhoto(index);

	}


	function closeLightbox() {

		/*
			Annule un éventuel chargement
			en attente.
		*/

		requestId++;

		lightbox.close();

	}


	function nextPhoto() {

		const nextIndex =
			(currentIndex + 1)
			% photoButtons.length;

		showPhoto(nextIndex);

	}


	function previousPhoto() {

		const previousIndex =
			(
				currentIndex
				- 1
				+ photoButtons.length
			)
			% photoButtons.length;

		showPhoto(previousIndex);

	}


	photoButtons.forEach(
		(button, index) => {

			/*
				Sur téléphone, le téléchargement
				commence dès que le doigt touche
				la vignette, avant même le clic.
			*/

			button.addEventListener(
				"pointerdown",
				() => {

					preloadImage(
						button.dataset.src
					);

				},
				{
					passive: true
				}
			);


			button.addEventListener(
				"click",
				() => {

					openLightbox(index);

				}
			);

		}
	);


	closeButton.addEventListener(
		"click",
		closeLightbox
	);


	nextButton.addEventListener(
		"click",
		nextPhoto
	);


	previousButton.addEventListener(
		"click",
		previousPhoto
	);


	lightbox.addEventListener(
		"click",
		(event) => {

			if (
				event.target === lightbox
			) {

				closeLightbox();

			}

		}
	);


	document.addEventListener(
		"keydown",
		(event) => {

			if (!lightbox.open) {
				return;
			}


			if (
				event.key === "ArrowRight"
			) {

				nextPhoto();

			}


			if (
				event.key === "ArrowLeft"
			) {

				previousPhoto();

			}

		}
	);

</script>