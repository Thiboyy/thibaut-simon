---
import Header from "../../components/Header.astro";
import { Image } from "astro:assets";

import cover4L from "../../assets/photos/4L/cover_4L.jpg";
import coverParis from "../../assets/photos/Paris/cover_Paris.jpg";
import coverThailande from "../../assets/photos/Thailande/cover_Thailande.jpg";
import coverMaroc from "../../assets/photos/Maroc/cover_Maroc.jpg";
import coverBleu from "../../assets/photos/BLEU/cover_bleu.jpg";
import coverRinjani from "../../assets/photos/rinjani/cover_rinjani.jpg";
import coverPortrait from "../../assets/photos/Portrait/cover_portrait.jpg";



const albums = [
	{
	name: "Portrait",
	url: "/photos/portrait/",
	cover: coverPortrait
	},
	{
		name: "4L",
		url: "/photos/4L/",
		cover: cover4L,
	},
	{
		name: "Paris",
		url: "/photos/paris/",
		cover: coverParis,
	},
	{
		name: "Thaïlande",
		url: "/photos/thailande/",
		cover: coverThailande,
	},
    {
        name: "Maroc",
        url: "/photos/maroc/",
        cover: coverMaroc,
    },

    {
        name: "#BLEU",
        url: "/photos/bleu/",
        cover: coverBleu,
    },

    {
        name: "MONT RINJANI & MONT BATUR",
        url: "/photos/rinjani/",
        cover: coverRinjani,
    },
];
---

<!doctype html>

<html lang="fr">

<head>
	<meta charset="UTF-8" />
	<meta
		name="viewport"
		content="width=device-width, initial-scale=1"
	/>

	<title>Photos — Thibaut Simon</title>
</head>

<script>

	const albums = document.querySelectorAll(".album");

	albums.forEach((album) => {

		const image = album.querySelector("img");

		if (!image) {
			album.classList.add("is-visible");
			return;
		}

		const revealAlbum = () => {
			album.classList.add("is-visible");
		};

		if (image.complete) {

			revealAlbum();

		} else {

			image.addEventListener(
				"load",
				revealAlbum,
				{ once: true }
			);

		}

	});

</script>

<body>

	<Header />

	<main>

		<h1>Photos</h1>

		<section class="albums">

			{
				albums.map((album, index) => (

					<a 
						href={album.url} 
						class="album"
						style={`--delay: ${index * 80}ms`}
					>

						<div class="cover">
							<Image
							src={album.cover}
							alt={album.name}
							widths={[320, 480, 640, 900]}
							sizes="(max-width: 600px) 50vw, (max-width: 900px) 50vw, 33vw"
						/>
						</div>

						<h2>{album.name}</h2>

					</a>

				))
			}

		</section>

	</main>

</body>

</html>


<style>

	* {
		box-sizing: border-box;
	}

	html {
		font-family: Arial, Helvetica, sans-serif;
		background: white;
		color: #111;
	}

	body {
		margin: 0;
	}

	main {
		padding: 70px 36px 150px;
	}

	h1 {
		margin: 0 0 60px;

		font-size: clamp(40px, 6vw, 80px);
		font-weight: 400;

		letter-spacing: -0.04em;
	}

	.albums {
		display: grid;

		grid-template-columns: repeat(3, 1fr);

		gap: 25px;
	}

	.album {
		color: inherit;
		text-decoration: none;

		min-width: 0;

		opacity: 0;
		transform: translateY(14px);

		transition:
			opacity 0.65s ease,
			transform 0.65s ease;

		transition-delay: var(--delay);
	}

	.album.is-visible {
		opacity: 1;
		transform: translateY(0);
	}

	@keyframes albumAppear {

		from {
			opacity: 0;
			transform: translateY(12px);
		}

		to {
			opacity: 1;
			transform: translateY(0);
		}

	}

    .cover {
        overflow: hidden;
    }

    .cover img {
        display: block;

        width: 100%;
        height: auto;

        transition: transform 0.3s ease;
    }

	.album:hover .cover img {
		transform: scale(1.02);
	}

	h2 {
		margin: 12px 0 0;

		font-size: 12px;
		font-weight: 400;

		letter-spacing: 0.12em;

		text-transform: uppercase;
	}


	@media (max-width: 900px) {

		.albums {
			grid-template-columns: repeat(2, 1fr);
		}

	}


    @media (max-width: 600px) {

        main {
            padding: 40px 18px 80px;
        }

        .albums {
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: 22px 12px;
        }

        .album {
            min-width: 0;
        }

        h2 {
            margin-top: 8px;
            font-size: 9px;
            line-height: 1.3;
        }

    }

	

</style>