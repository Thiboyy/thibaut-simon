
---
import Header from "../../components/Header.astro";
import AlbumGallery from "../../components/AlbumGallery.astro";

const imageModules = import.meta.glob(
  "/src/assets/photos/Portrait/*.{jpg,jpeg,JPG,JPEG,png,PNG,webp,WEBP}",
  { eager: true, import: "default" }
);

const photos = Object.entries(imageModules)
  .filter(([path]) => !path.toLowerCase().includes("cover_"))
  .sort(([pathA], [pathB]) =>
    pathA.localeCompare(pathB, undefined, { numeric: true })
  )
  .map(([path, image]) => ({
    image: image as any,
    alt: path.split("/").pop()?.replace(/\.[^.]+$/, "") ?? "Portrait",
  }));
---

<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Portrait — Thibaut Simon Photography</title>
  </head>
  <body>
    <Header />
    <AlbumGallery title="Portrait" photos={photos} />
  </body>
</html>
